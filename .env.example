# Local development only. ClickHouse runs without a password on the default user;
# nothing here is intended to leave your machine.

CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=otel
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=aftermerge
POSTGRES_PASSWORD=aftermerge
POSTGRES_DB=shopdemo

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Optional. Only needed for the model-backed test and patch generators; the
# deterministic ones run without it. Never commit a real key.
ANTHROPIC_API_KEY=
AFTERMERGE_MODEL=claude-sonnet-5
